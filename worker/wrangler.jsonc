{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "town-2100-api",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  // No public address. The Worker is reached only through the service binding CHAT_API of the page's own /api/chat
  // (functions/api/chat.ts, configured in the root wrangler.jsonc), so the account's workers.dev name is not in the
  // page, the repository or any link. Pinned by worker/wranglerConfig.test.ts. Preview URLs are switched off for the
  // same reason (they are workers.dev addresses too).
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs, for the Worker's own console lines only. The Worker writes only constant strings (pinned by the
  // "console output" tests in worker/index.test.ts; the list is in worker/README.md, section "ログ"): no argument, so
  // no API key, client address, upstream body or error text. Cloudflare may attach its own metadata to a recorded
  // line, which cannot be checked offline: step 9 of the deploy checklist opens one recorded line to look. The
  // automatic per-request "invocation logs" (URL, headers, client details) are switched off, traces are not enabled,
  // and every line is kept (sampling 100%).
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },
  // Caps what ONE invocation may use, a guard against runaway bills ("denial of wallet"; Cloudflare's own wording for
  // this setting). A normal call needs a few ms of CPU and about 21 subrequests (1 upstream call, 17 KV reads, 2 KV
  // writes, the burst limiter), so these are generous. Needs the Workers Paid plan. This is not a spending cap:
  // Cloudflare has none; see "請求の安全" in worker/README.md.
  "limits": {
    "cpu_ms": 100,
    "subrequests": 60
  },
  "kv_namespaces": [
    {
      "binding": "RATE_KV",
      // The namespace "town-2100-rate" in the owner's Cloudflare account (created 2026-11-06).
      "id": "67f232b83c354aa79f65397665815b6e"
    }
  ],
  // Burst limiter: at most 20 calls per 60 seconds per visitor (the key is an HMAC of the client address, set in
  // worker/index.ts). Wrangler 4.36 or later. `period` can only be 10 or 60. The count is kept per Cloudflare
  // location and is eventually consistent, so it is a courtesy limit, not accounting (the Anthropic workspace spend
  // limit is the hard stop). `namespace_id` is a positive integer, written as a string, that must be unique in the
  // Cloudflare account: bindings that share one share their counters, so pick another number if 21001 is in use.
  "ratelimits": [
    {
      "name": "IP_LIMITER",
      "namespace_id": "259554",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    // Comma-separated page origins allowed to call the Worker (exact match). This keeps other websites' browsers
    // out; it is NOT authentication (curl can send any Origin). The Anthropic workspace spend limit is the hard stop.
    // The public page (Cloudflare Pages project japan2100); no trailing slash.
    "ALLOWED_ORIGINS": "https://japan2100.pages.dev"
    // Optional overrides; defaults are 400 a day in total and 60 a day per IP. They count upstream calls, and one
    // question can use up to 9. Set DAILY_TOTAL_LIMIT to "0" to switch the AI off (for example after the event).
    // "DAILY_TOTAL_LIMIT": "400",
    // "DAILY_IP_LIMIT": "60"
  }
  // The key and the IP hashing secret are secrets, not vars: `wrangler secret put ANTHROPIC_API_KEY` and
  // `wrangler secret put IP_HASH_SECRET` at deploy time.
  // For local development put them in worker/.dev.vars (git-ignored); see worker/.dev.vars.example.
  // Before deploying, work through the checklist in worker/README.md (spend limit first).
}
